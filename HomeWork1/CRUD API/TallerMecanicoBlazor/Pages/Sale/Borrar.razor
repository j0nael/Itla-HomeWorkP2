@page "/sales/delete/{id:int}"
@using TallerMecanicoBlazor.Frontend
@inject SaleService SaleService
@inject NavigationManager Nav

<h3>Eliminar Venta</h3>

<p>¿Seguro que deseas eliminar esta venta?</p>

<button class="btn btn-danger" @onclick="Delete">Sí, eliminar</button>

@code {
    [Parameter] public int id { get; set; }

    async Task Delete()
    {
        await SaleService.DeleteAsync(id);
        Nav.NavigateTo("/sales");
    }
}
