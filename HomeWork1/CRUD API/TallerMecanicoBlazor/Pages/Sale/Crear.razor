@page "/sales/create"
@using TallerMecanicoBlazor.Frontend
@using tallermecanico.aplication.DTOs

@inject SaleService SaleService
@inject CustomerService CustomerService
@inject SellerService SellerService
@inject NavigationManager Nav

<h3>Nueva Venta</h3>

<div class="card p-4">

    <div class="mb-3">
        <label>Cliente</label>
        <select class="form-select" @bind="sale.CustomerId">
            <option value="">Seleccione un cliente</option>
            @foreach (var c in customers)
            {
                <option value="@c.CustomerId">@c.FirstName @c.LastName</option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label>Vendedor</label>
        <select class="form-select" @bind="sale.SellerId">
            <option value="">Seleccione un vendedor</option>
            @foreach (var s in sellers)
            {
                <option value="@s.SellerId">@s.FirstName @s.LastName</option>
            }
        </select>
    </div>

    <button class="btn btn-success" @onclick="CreateSale">
        Guardar
    </button>
</div>

@code {
    SaleDTO sale = new();
    List<CustomerDTO> customers = new();
    List<SellerDTO> sellers = new();

    protected override async Task OnInitializedAsync()
    {
        customers = await CustomerService.GetAll();
        sellers = await SellerService.GetAllAsync();
    }

    async Task CreateSale()
    {
        sale.Total = 0;
        sale.InvoiceId = null;

        await SaleService.CreateAsync(sale);
        Nav.NavigateTo("/sales");
    }
}
