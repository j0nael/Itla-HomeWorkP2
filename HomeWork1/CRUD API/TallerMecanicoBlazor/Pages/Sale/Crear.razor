@page "/sales/create"
@using TallerMecanicoBlazor.Frontend
@using tallermecanico.aplication.DTOs
@inject SaleService SaleService
@inject HttpClient Http
@inject NavigationManager Nav

<h3>Nueva Venta</h3>

<div class="card p-4 shadow">

    <div class="mb-3">
        <label>Cliente</label>
        <select class="form-select" @bind="sale.CustomerId">
            <option value="0">Seleccione un cliente</option>
            @foreach (var c in customers)
            {
                <option value="@c.CustomerId">@($"{c.FirstName} {c.LastName}")</option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label>Vendedor</label>
        <select class="form-select" @bind="sale.SellerId">
            <option value="0">Seleccione un vendedor</option>
            @foreach (var s in sellers)
            {
                <option value="@s.SellerId">@($"{s.FirstName} {s.LastName}")</option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label>Pieza</label>
        <select class="form-select" @bind="selectedPartId">
            <option value="0">Seleccione una pieza</option>
            @foreach (var p in spareParts)
            {
                <option value="@p.SparePartId">@($"{p.Name} - RD$ {p.UnitPrice}")</option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label>Cantidad</label>
        <input type="number" min="1" class="form-control" @bind="quantity" />
    </div>

    <button class="btn btn-success" @onclick="CreateSale">Crear Venta</button>
</div>

@code {
    SaleDTO sale = new();
    List<CustomerDTO> customers = new();
    List<SellerDTO> sellers = new();
    List<SparePartDTO> spareParts = new();

    int selectedPartId = 0;
    int quantity = 1;

    protected override async Task OnInitializedAsync()
    {
        customers = await Http.GetFromJsonAsync<List<CustomerDTO>>("api/customer");
        sellers = await Http.GetFromJsonAsync<List<SellerDTO>>("api/seller");
        spareParts = await Http.GetFromJsonAsync<List<SparePartDTO>>("api/sparepart");
    }

    private async Task CreateSale()
    {
        var part = spareParts.First(p => p.SparePartId == selectedPartId);

        sale.Details.Add(new SaleDetailDTO
        {
            SparePartId = part.SparePartId,
            Quantity = quantity,
            UnitPrice = part.UnitPrice
        });

        var newSale = await SaleService.CreateAsync(sale);

        Nav.NavigateTo($"/sales/details/{newSale.SaleId}");
    }
}
