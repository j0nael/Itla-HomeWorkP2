@page "/sellers/delete/{id:int}"
@using TallerMecanicoBlazor.Frontend
@using tallermecanico.aplication.DTOs
@inject SellerService SellerService
@inject NavigationManager Nav

<h3>Eliminar Vendedor</h3>

<p>¿Seguro que deseas eliminar este vendedor?</p>

<button class="btn btn-danger" @onclick="Delete">Sí, eliminar</button>

@code {
    [Parameter] public int id { get; set; }

    async Task Delete()
    {
        await SellerService.DeleteAsync(id);
        Nav.NavigateTo("/sellers");
    }
}
