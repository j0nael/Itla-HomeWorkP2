@page "/spareparts/delete/{id:int}"
@using TallerMecanicoBlazor.Frontend
@inject SparePartService SparePartService
@inject NavigationManager Nav

<h3>Eliminar Repuesto</h3>

<p>¿Seguro que deseas eliminar este repuesto?</p>

<button class="btn btn-danger" @onclick="Delete">Sí, eliminar</button>
<button class="btn btn-secondary" @onclick="Cancel">Cancelar</button>

@code {
    [Parameter] public int id { get; set; }

    async Task Delete()
    {
        await SparePartService.DeleteAsync(id);
        Nav.NavigateTo("/spareparts");
    }

    void Cancel() => Nav.NavigateTo("/spareparts");
}
